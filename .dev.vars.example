# Copy to .dev.vars for local development. As it stands nothing here is a
# secret: you are signed in as the person named below, and alerts are written
# to the terminal instead of sent.

# Who lives here, as id:Name pairs. The ids are what a to-do stores.
PEOPLE=alex:Alex,sam:Sam

# The household's IANA time zone, such as America/Chicago. Deadlines and
# alert times are wall-clock times in it.
HOUSEHOLD_TZ=UTC

# Dev server only: be this person (an id from PEOPLE) without signing in.
# Empty it to go through real sign-in, which then needs the four settings
# under it.
DEV_SIGNED_IN_AS=alex

# Sign-in with Google. The Google client also needs
# http://localhost:3001/api/auth/callback/google as a redirect URI.
# Any 32 or more random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# id:email pairs, ids as in PEOPLE: the Google accounts allowed in.
PEOPLE_EMAILS=

# Optional. Google Calendar sync: any 32 or more random characters, which
# seal the calendar tokens kept in the database. Needs the Google client
# above too, with http://localhost:3001/api/calendar/callback as a redirect
# URI and the Calendar API enabled. Empty: nobody can connect a calendar.
CALENDAR_TOKEN_KEY=

# The Pushover application token.
PUSHOVER_APP_TOKEN=

# id:userkey pairs, ids as in PEOPLE.
PUSHOVER_USER_KEYS=

# Optional. A TypeSafe AI key: the add bar's rules still read a new to-do's
# title, and their Jev model then checks that reading (picks a tag where the
# rules found none, and says whether a date that was read is one). That
# sends them the title, today's date and the tag names. Empty: off, and the
# rules' reading stands alone.
TYPESAFE_API_KEY=

# In dev, links and Google's reply should point at the laptop, not the
# deployed app.
APP_URL=http://localhost:3001
